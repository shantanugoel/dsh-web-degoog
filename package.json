{
  "name": "dsh-web-degoog",
  "version": "0.2.0",
  "description": "DeepSeek Harness web-search/web-fetch provider bundle backed by any degoog instance",
  "license": "MIT",
  "author": "Shantanu Goel",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "degoog",
    "search",
    "self-hosted"
  ],
  "files": [
    "lib",
    "agent-presets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-web": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shantanugoel/dsh-web-degoog.git"
  },
  "bugs": "https://github.com/shantanugoel/dsh-web-degoog/issues",
  "homepage": "https://github.com/shantanugoel/dsh-web-degoog#readme"
}
