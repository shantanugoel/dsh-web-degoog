{
  "name": "dsh-web-degoog",
  "version": "0.4.0",
  "description": "DeepSeek Harness web-search/web-fetch provider bundle backed by any degoog instance",
  "license": "MIT",
  "author": "Shantanu Goel",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node scripts/smoke.mjs",
    "test:client": "node scripts/client-smoke.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-credentials": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-launch-environment": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-web": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "degoog",
    "search",
    "self-hosted"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-launch-environment": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-web": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-credentials": { "optional": true },
    "@deepseek-ai/dsh-launch-environment": { "optional": true },
    "@deepseek-ai/dsh-web": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shantanugoel/dsh-web-degoog.git"
  },
  "bugs": "https://github.com/shantanugoel/dsh-web-degoog/issues",
  "homepage": "https://github.com/shantanugoel/dsh-web-degoog#readme"
}